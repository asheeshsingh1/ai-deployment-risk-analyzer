APP_NAME=deployment-risk-analyzer
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/deployment_risk

# Optional.
# Required only when analyzing GitHub changes.
GITHUB_TOKEN=your_github_api_key

# Optional.
# Required only when analyzing GitLab changes.
GITLAB_TOKEN=your_gitlab_api_key

# Optional.
# Required only when analyzing BitBucket changes.
BITBUCKET_TOKEN=your_bitbucket_api_key

# Optional.
# Required only when AI explanation/recommendation is requested.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash